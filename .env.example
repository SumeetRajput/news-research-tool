# Copy this file to ".env" and fill in real values.
# .env is gitignored - never commit real keys.

# Groq powers reasoning, speech-to-text and text-to-speech.
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Free Developer tier: https://newsapi.org/register
NEWSAPI_KEY=

# Optional. Runs locally, always free.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
